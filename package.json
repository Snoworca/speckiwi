{
  "name": "speckiwi",
  "version": "2.9.0",
  "description": "SpecKiwi manages Git-tracked Markdown SRS requirements through a local CLI and stdio MCP server.",
  "type": "module",
  "bin": {
    "speckiwi": "./bin/speckiwi"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./cli/command": {
      "types": "./dist/cli/command.d.ts",
      "import": "./dist/cli/command.js"
    },
    "./core/result": {
      "types": "./dist/core/result.d.ts",
      "import": "./dist/core/result.js"
    },
    "./core/types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js"
    },
    "./mcp/server": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "docs/rule/SRS-MD-Rules-v2.5.0.md",
    "docs/rule/SDS-MD-Rules-v2.5.0.md",
    "docs/.kiwi/hooks",
    "skills/codex",
    "skills/claude",
    "skills/etc"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint src test --ext .ts --max-warnings=0",
    "test": "vitest run --hookTimeout 30000 --testTimeout 30000 --no-file-parallelism",
    "test:coverage": "vitest run --coverage --hookTimeout 60000 --testTimeout 60000 --no-file-parallelism",
    "test:integration": "vitest run test/integration test/cli test/mcp --hookTimeout 60000 --testTimeout 60000 --no-file-parallelism",
    "release:acceptance": "vitest run test/release/release-readiness.test.ts test/release/srs-traceability.test.ts --hookTimeout 60000 --testTimeout 60000",
    "version:check": "npm run build && node scripts/version-check.mjs",
    "release:check": "npm run version:check && node scripts/release-check.mjs --strict",
    "perf:srs": "vitest run test/perf/parser-performance.test.ts --hookTimeout 120000 --testTimeout 120000",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snoworca/speckiwi.git"
  },
  "keywords": [
    "srs",
    "mcp",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Snoworca/speckiwi/issues"
  },
  "homepage": "https://github.com/Snoworca/speckiwi#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.57.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "es2022": true,
      "node": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": "latest"
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "rules": {
      "@typescript-eslint/consistent-type-imports": "error"
    }
  }
}
