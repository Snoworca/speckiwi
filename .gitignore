# Local/generated archives
*.zip

# Dependencies and local execution state
node_modules/
.snoworca/
kiwi/.pipeline-path
kiwi/.status.json
kiwi/.srs.lock
kiwi/.srs.lock.guard
# Orchestrator machine state: `git clean -fd` may remove it and `git add -A` must never stage it.
kiwi/waves.jsonl
kiwi/orchestrator/
# The agent runtime creates an isolated Profile A lane checkout here. Tracked rather than left to
# `.git/info/exclude`, which is local and unshared and so absent on a fresh clone or a CI runner.
# `**/` matches the reach of the exclude line it replaces: a root-anchored `.claude/worktrees/` would
# leave a nested one staged by `git add -A` on a fresh clone. @req FR-NODE-181
**/.claude/worktrees/

# Build output (regenerated via `npm run build` / `prepack`)
dist/

# OS/editor noise
.DS_Store
Thumbs.db

# Local runtime/session state and tool caches
.kiwi/
# …except the bundled hook runners. `init` copies these OUT of the installed package into a target
# project (`init-project.ts` `loadBundledHookRunner`), so they are package SOURCE, not session
# state — and `.kiwi/` above matched them only because the runtime directory shares the name.
# While they were ignored they were also absent from the npm tarball, so every consumer got the
# `process.exit(0)` fallback instead of a working governance hook. @req FR-NODE-183
!docs/.kiwi/
docs/.kiwi/*
!docs/.kiwi/hooks/
.serena/

# Atomic-write scratch files. `apply-patch.ts` writes `.speckiwi-<uuid>.tmp` beside the file it
# patches, so the directory follows the document — `docs/spec/` for a scope SRS but
# `docs/spec/steps/<task>/` for a step one — and `merge-journal.ts` writes two further shapes at the
# repository root. Keyed to the filename rather than to one directory: the first version of this
# entry named `docs/spec/` alone, which left every other site staged by `git add -A`. @req FR-NODE-158
.speckiwi-*.tmp
.speckiwi-merge-journal.json.*.tmp

# A leaked FR-NODE-164 typecheck probe errors by construction; never commit one.
test/core/orchestrator/__fr-node-164-probe.ts
